/* ---- cable detail: breakdown + assignment editor (shared by diagram & cables tab) ---- */
function cableDetailHTML(cable){
  const groups = cable.coreCount ? cableBreakdownGroups(cable) : [];
  const rows = groups.map(g=>{
    const res = traceRangeChain(cable.id, g.rs, g.re, new Set());
    let chainHtml = res.chain.map(h=>`<span class="chain-arrow">←</span><span class="chain-hop">${esc(cableName(h.cableId))} (${h.rs===h.re?('#'+h.rs):(h.rs+'-'+h.re)})</span>`).join('');
    let finalHtml='';
    if(res.end.type==='terminate') finalHtml = `<span class="chain-arrow">←</span><span class="chain-final term">پایان: ${esc(res.end.label)}</span>`;
    else if(res.end.type==='unassigned') finalHtml = `<span class="chain-arrow">←</span><span class="chain-final unassigned">ادامه تعریف نشده</span>`;
    else if(res.end.type==='cycle') finalHtml = `<span class="chain-arrow">←</span><span class="chain-final cycle">حلقهٔ اتصال!</span>`;
    const sw1 = swatchHTML(g.rs), sw2 = g.re!==g.rs?swatchHTML(g.re):'';
    return `<div class="chain-row">
      <span class="swatch-pair">${sw1}${sw2}</span>
      <span class="chain-range">کور ${g.rs===g.re?('#'+g.rs):(g.rs+' تا '+g.re)}</span>
      ${chainHtml}${finalHtml}
    </div>`;
  }).join('');

  const assigns = assignmentsFor(cable.id);
  const assignRows = assigns.map(a=>{
    const desc = a.action==='terminate' ? `پایان: ${esc(a.label)}` : `ادامه در ${esc(cableName(a.toCableId))} از کور #${a.toCoreStart}`;
    return `<tr><td>${a.coreStart===a.coreEnd?('#'+a.coreStart):(a.coreStart+'-'+a.coreEnd)}</td><td>${desc}</td><td><button class="btn btn-sm btn-danger" data-action="deleteAssignment" data-id="${a.id}" data-cable="${cable.id}">حذف</button></td></tr>`;
  }).join('');

  const addForm = state.showAddAssign ? assignFormHTML(cable) :
    `<div class="form-actions" style="margin-top:10px;"><button class="btn btn-primary btn-sm" data-action="toggleAssignForm">+ تعریف انشعاب جدید</button></div>`;

  return `<div class="card"><div class="card-body" style="border-top:none;">
    <div class="section-head">
      <div class="section-title">${esc(cable.name)} <span style="color:var(--muted);font-size:12px;font-weight:400;">(${esc(nodeName(cable.fromNodeId))} ← ${esc(nodeName(cable.toNodeId))})</span></div>
      <div class="btn-row">
        <button class="btn btn-sm" data-action="editCable" data-id="${cable.id}">ویرایش</button>
        <button class="btn btn-sm" data-action="closeCablePanel">بستن</button>
      </div>
    </div>
    <div class="hint">${cable.coreCount} کور ${cable.length?(' · '+cable.length+' متر'):''} ${cable.notes?(' · '+esc(cable.notes)):''}</div>

    <div class="form-title" style="margin-top:16px;">مسیر و مقصد نهایی کورها</div>
    ${rows || '<div class="hint">این کابل کوری ندارد.</div>'}

    <div class="form-title" style="margin-top:16px;">انشعاب‌های تعریف‌شده در ${esc(nodeName(cable.toNodeId))}</div>
    ${assigns.length ? `<table class="table"><thead><tr><th>بازهٔ کور</th><th>سرنوشت</th><th></th></tr></thead><tbody>${assignRows}</tbody></table>` : '<div class="hint">هنوز انشعابی برای این کابل تعریف نشده.</div>'}
    ${addForm}
  </div></div>`;
}

