    </div>
    <div class="form-actions"><button type="submit" class="btn btn-primary">ردیابی</button></div>
  </form>`;
  if(state.traceCableId && state.traceCore){
    const cable = getCable(state.traceCableId);
    const n = Number(state.traceCore);
    if(cable && n>=1 && n<=cable.coreCount){
      const res = traceRangeChain(cable.id, n, n, new Set());
      let chainHtml = res.chain.map(h=>`<span class="chain-arrow">←</span><span class="chain-hop">${esc(cableName(h.cableId))} (#${h.rs})</span>`).join('');
      let finalHtml='';
      if(res.end.type==='terminate') finalHtml=`<span class="chain-arrow">←</span><span class="chain-final term">پایان: ${esc(res.end.label)}</span>`;
      else if(res.end.type==='unassigned') finalHtml=`<span class="chain-arrow">←</span><span class="chain-final unassigned">ادامه تعریف نشده</span>`;
      else if(res.end.type==='cycle') finalHtml=`<span class="chain-arrow">←</span><span class="chain-final cycle">حلقهٔ اتصال!</span>`;
      html += `<div class="chain-row">${swatchHTML(n)} <span class="chain-range">${esc(cable.name)} — کور #${n}</span>${chainHtml}${finalHtml}</div>`;
      html += `<div class="hint">${coreLabelShort(n)}</div>`;
    }
  }
  return html;
}

/* ================= helpers ================= */
function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g, m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m])); }
function overlaps(aS,aE,bS,bE){ return aS<=bE && bS<=aE; }

/* ================= actions ================= */
async function handleAction(action, ds, el, evt){
  if(action==='setView'){ state.view=ds.view; render(); return; }
  if(action==='openCableFromList'){ state.view='cables'; state.activeCableId=ds.id; render(); return; }

  /* diagram modes */
  if(action==='modeAddNode'){ state.diagMode='placingNode'; state.activeCableId=null; state.activeNodeId=null; render(); return; }
  if(action==='modeAddCable'){ state.diagMode='connectPick1'; state.connectFromId=null; state.activeCableId=null; state.activeNodeId=null; render(); return; }
  if(action==='modeMoveNode'){ state.diagMode='movePick1'; state.moveNodeId=null; render(); return; }
  if(action==='modeCancel'){ state.diagMode='view'; state.connectFromId=null; state.moveNodeId=null; state.pendingNode=null; state.pendingCable=null; render(); return; }

  if(action==='canvasClick'){
    const rect = el.closest('svg').getBoundingClientRect();
    const cx = Math.round(evt.clientX - rect.left), cy = Math.round(evt.clientY - rect.top);
    if(state.diagMode==='placingNode'){ state.pendingNode={x:cx,y:cy}; state.diagMode='view'; render(); return; }
    if(state.diagMode==='movePick2'){
      const n = getNode(state.moveNodeId);
      if(n){ n.x=cx; n.y=cy; await saveNodes(); }
      state.diagMode='view'; state.moveNodeId=null; render(); return;
    }
    // plain view mode: deselect
    if(state.diagMode==='view'){ state.activeCableId=null; state.activeNodeId=null; render(); }
    return;
  }

  if(action==='nodeClick'){
    if(state.diagMode==='connectPick1'){ state.connectFromId=ds.id; state.diagMode='connectPick2'; render(); return; }
    if(state.diagMode==='connectPick2'){
      if(ds.id===state.connectFromId){ toast('دو گره باید متفاوت باشند', true); return; }
      state.pendingCable={fromNodeId:state.connectFromId, toNodeId:ds.id};
      state.diagMode='view'; state.connectFromId=null; render(); return;
    }
    if(state.diagMode==='movePick1'){ state.moveNodeId=ds.id; state.diagMode='movePick2'; render(); return; }
    if(state.diagMode==='view'){ state.activeNodeId=ds.id; state.activeCableId=null; render(); return; }
    return;
  }
  if(action==='cableClick'){
    if(state.diagMode==='view'){ state.activeCableId=ds.id; state.activeNodeId=null; render(); }
    return;
  }
  if(action==='toggleCableRow'){ state.activeCableId = state.activeCableId===ds.id? null: ds.id; state.editingCableId=null; render(); return; }

  /* node form */
  if(action==='cancelNodeForm'){ state.pendingNode=null; state.editingNodeId=null; render(); return; }
  if(action==='editNode'){ state.editingNodeId=ds.id; render(); return; }
  if(action==='closeNodePanel'){ state.activeNodeId=null; render(); return; }
  if(action==='deleteNode'){
    if(confirm('این گره حذف شود؟ کابل‌های متصل به آن هم حذف خواهند شد.')){
      const cablesToRemove = state.cables.filter(c=>c.fromNodeId===ds.id || c.toNodeId===ds.id).map(c=>c.id);
      state.cables = state.cables.filter(c=>!cablesToRemove.includes(c.id));
      state.assignments = state.assignments.filter(a=>!cablesToRemove.includes(a.cableId) && !cablesToRemove.includes(a.toCableId));
      state.nodes = state.nodes.filter(n=>n.id!==ds.id);
      state.editingNodeId=null; state.activeNodeId=null; state.activeCableId=null;
      await saveNodes(); await saveCables(); await saveAssignments();
      toast('گره حذف شد'); render();
    }
    return;
  }

  /* cable form */
  if(action==='cancelCableForm'){ state.pendingCable=null; state.editingCableId=null; render(); return; }
  if(action==='editCable'){ state.editingCableId=ds.id; render(); return; }
  if(action==='closeCablePanel'){ state.activeCableId=null; render(); return; }
  if(action==='deleteCable'){
    if(confirm('این کابل و انشعاب‌های آن حذف شود؟')){
      state.assignments = state.assignments.filter(a=>a.cableId!==ds.id && a.toCableId!==ds.id);
      state.cables = state.cables.filter(c=>c.id!==ds.id);
      state.editingCableId=null; state.activeCableId=null;
      await saveCables(); await saveAssignments();
      toast('کابل حذف شد'); render();
    }
    return;
  }
  if(action==='toggleManualCable'){ state.showManualCableForm=!state.showManualCableForm; render(); return; }
  if(action==='cancelManualCable'){ state.showManualCableForm=false; render(); return; }

  /* assignment form */
  if(action==='toggleAssignForm'){ state.showAddAssign=true; state.assignAction='continue'; render(); return; }
  if(action==='cancelAssignForm'){ state.showAddAssign=false; render(); return; }
  if(action==='setAssignAction'){ state.assignAction=el.value; render(); return; }
  if(action==='deleteAssignment'){
    if(confirm('این انشعاب حذف شود؟')){
      state.assignments = state.assignments.filter(a=>a.id!==ds.id);
      await saveAssignments(); render();
    }
    return;
  }
}

function initDelegation(){
  const app = document.getElementById('app');

  app.addEventListener('click', e=>{
    const t = e.target.closest('[data-action]');
    if(!t) return;
    handleAction(t.dataset.action, t.dataset, t, e);
  });

  app.addEventListener('change', e=>{
    const t = e.target;
    if(t.matches('[data-action="setAssignAction"]')) handleAction('setAssignAction', {}, t, e);
  });

  app.addEventListener('input', e=>{
    const t = e.target;
    if(t.dataset && t.dataset.bind){
      state[t.dataset.bind] = t.value;
      const focusBind = t.dataset.bind, caret = t.selectionStart;
      render();
      const again = app.querySelector(`[data-bind="${focusBind}"]`);
      if(again){ again.focus(); try{ again.setSelectionRange(caret, caret); }catch(err){} }
    }
  });

  app.addEventListener('submit', async e=>{
    e.preventDefault();
    const form = e.target.closest('form');
    if(!form) return;
    const action = form.dataset.action;
    const fd = new FormData(form);

    if(action==='submitNode'){
      const name = (fd.get('name')||'').trim();
      if(!name){ toast('نام گره الزامی است', true); return; }
      const type = fd.get('type');
      const x = Number(fd.get('x')), y = Number(fd.get('y'));
      const editingId = form.dataset.id;
      if(editingId){
        const n = getNode(editingId); Object.assign(n, {name, type});
        state.editingNodeId=null;
      } else {
        state.nodes.push({id:uid(), name, type, x, y});
        state.pendingNode=null;
      }
      await saveNodes(); toast('گره ذخیره شد'); render();
      return;
    }

    if(action==='submitCable'){
      const name=(fd.get('name')||'').trim();
      const coreCount=parseInt(fd.get('coreCount'),10);
      const length=fd.get('length')?parseFloat(fd.get('length')):null;
      const notes=(fd.get('notes')||'').trim();
      if(!name){ toast('نام کابل الزامی است', true); return; }
      if(!coreCount||coreCount<1){ toast('تعداد کور نامعتبر است', true); return; }
      const editingId = form.dataset.id;
      if(editingId){
        const c = getCable(editingId);
        Object.assign(c, {name, coreCount, length, notes});
        state.editingCableId=null;
      } else {
        let fromNodeId = form.dataset.from, toNodeId = form.dataset.to;
        if(!fromNodeId) fromNodeId = fd.get('fromNodeId');
        if(!toNodeId) toNodeId = fd.get('toNodeId');
        if(!fromNodeId || !toNodeId || fromNodeId===toNodeId){ toast('گره مبدأ و مقصد باید متفاوت باشند', true); return; }
        state.cables.push({id:uid(), name, fromNodeId, toNodeId, coreCount, length, notes});
        state.pendingCable=null; state.showManualCableForm=false;
      }
      await saveCables(); toast('کابل ذخیره شد'); render();
      return;
    }

    if(action==='submitAssignment'){
      const cableId = form.dataset.cable;
      const cable = getCable(cableId);
      if(!cable) return;
      const coreStart = parseInt(fd.get('coreStart'),10);
      const coreEnd = parseInt(fd.get('coreEnd'),10);
      if(!coreStart || !coreEnd || coreStart<1 || coreEnd>cable.coreCount || coreStart>coreEnd){ toast('بازهٔ کور نامعتبر است', true); return; }
      const existing = assignmentsFor(cableId);
      if(existing.some(a=>overlaps(a.coreStart,a.coreEnd,coreStart,coreEnd))){ toast('این بازه با انشعاب دیگری از همین کابل تداخل دارد', true); return; }

      const action2 = fd.get('action') || state.assignAction;
      let data = {id:uid(), cableId, coreStart, coreEnd, action:action2};
      if(action2==='terminate'){
        data.label = (fd.get('label')||'').trim() || nodeName(cable.toNodeId);
      } else {
        const toCableId = fd.get('toCableId');
        const toCoreStart = parseInt(fd.get('toCoreStart'),10);
        const toCable = getCable(toCableId);
        if(!toCable){ toast('کابل مقصد نامعتبر است', true); return; }
        if(toCable.fromNodeId!==cable.toNodeId){ toast('کابل مقصد باید از همان گره خارج شود', true); return; }
        const span = coreEnd-coreStart;
        const toCoreEnd = toCoreStart+span;
        if(!toCoreStart || toCoreStart<1 || toCoreEnd>toCable.coreCount){ toast('بازهٔ کور در کابل مقصد خارج از محدوده است', true); return; }
        const targetExisting = state.assignments.filter(a=>a.toCableId===toCableId);
        if(targetExisting.some(a=>overlaps(a.toCoreStart, a.toCoreStart+(a.coreEnd-a.coreStart), toCoreStart, toCoreEnd))){
          toast('این بازه از کور کابل مقصد قبلاً استفاده شده', true); return;
        }
        data.toCableId=toCableId; data.toCoreStart=toCoreStart;
      }
      state.assignments.push(data);
      state.showAddAssign=false;
      await saveAssignments(); toast('انشعاب ثبت شد'); render();
      return;
    }

    if(action==='runTrace'){
      state.traceCableId = fd.get('cableId');
      state.traceCore = fd.get('core');
      render();
      return;
    }
  });
}

initDelegation();
loadData();
</script>
</body>
</html>
