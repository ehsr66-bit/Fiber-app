  if(q) list = list.filter(c=>(c.name+nodeName(c.fromNodeId)+nodeName(c.toNodeId)).toLowerCase().includes(q));

  if(state.cables.length===0){
    html += `<div class="empty-state">هنوز کابلی ثبت نشده.</div>`;
  } else if(list.length===0){
    html += `<div class="empty-state">کابلی با این مشخصات پیدا نشد.</div>`;
