    return html + `<div class="empty-state">برای ساخت کابل به حداقل دو گره نیاز داری.<br><button class="btn btn-primary" data-action="setView" data-view="diagram">رفتن به نمای شبکه</button></div>`;
  }

  if(state.showManualCableForm) html += manualCableFormHTML();

