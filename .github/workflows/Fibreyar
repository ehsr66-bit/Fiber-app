<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>فیبریار — مدیریت شبکه فیبر نوری FTTH</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap');

:root{
  --bg:#0F1626;
  --panel:#19233A;
  --panel-2:#212C46;
  --border:#2B3856;
  --text:#EDEFF7;
  --muted:#8D97B8;
  --accent:#3FD3C7;
  --accent-ink:#04211f;
  --amber:#E8A33D;
  --danger:#E2596B;
  --ok:#8FD98A;
  --violet:#B5179E;
  --radius:10px;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{font-family:'Vazirmatn',sans-serif;background:var(--bg);color:var(--text);line-height:1.6;min-height:100vh;}
button,input,select,textarea{font-family:inherit;}
.hidden{display:none !important;}

.banner{background:rgba(226,89,107,.12);border-bottom:1px solid var(--danger);color:var(--danger);padding:8px 20px;font-size:13px;text-align:center;}

.topbar{display:flex;align-items:center;justify-content:space-between;padding:16px 20px 12px;}
.brand{font-size:19px;font-weight:800;display:flex;align-items:center;gap:9px;}
.brand-dot{width:9px;height:9px;border-radius:50%;background:var(--accent);box-shadow:0 0 10px var(--accent);flex-shrink:0;}
.brand-sub{color:var(--muted);font-size:12px;font-weight:400;}

.tabs{display:flex;gap:4px;overflow-x:auto;padding:0 20px 12px;border-bottom:1px solid var(--border);}
.tab{padding:8px 15px;border-radius:8px;font-size:13.5px;color:var(--muted);cursor:pointer;white-space:nowrap;border:1px solid transparent;user-select:none;}
.tab.active{background:var(--panel-2);color:var(--text);border-color:var(--border);}

.container{padding:18px;max-width:1000px;margin:0 auto;}
.loading{text-align:center;padding:60px 20px;color:var(--muted);}

.stats-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px;margin-bottom:22px;}
.stat-card{background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);padding:15px 16px;border-right:3px solid var(--accent);}
.stat-num{font-size:24px;font-weight:800;}
.stat-label{color:var(--muted);font-size:12px;margin-top:4px;}

.section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;gap:10px;flex-wrap:wrap;}
.section-title{font-size:17px;font-weight:700;}

.btn{border:1px solid var(--border);background:var(--panel-2);color:var(--text);padding:9px 15px;border-radius:8px;font-size:13.5px;cursor:pointer;}
.btn:hover{border-color:var(--accent);}
.btn-primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);font-weight:700;}
.btn-danger{color:var(--danger);}
.btn-sm{padding:5px 11px;font-size:12px;}
.btn-row{display:flex;gap:8px;flex-wrap:wrap;}
.btn.active-mode{background:var(--amber);color:#2b1a02;border-color:var(--amber);font-weight:700;}

.search-input{background:var(--panel);border:1px solid var(--border);border-radius:8px;padding:9px 12px;color:var(--text);font-size:13.5px;width:100%;max-width:220px;}

.card{background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);margin-bottom:11px;overflow:hidden;}
.card-head{display:flex;justify-content:space-between;align-items:center;padding:13px 16px;cursor:pointer;gap:10px;}
.card-head-main{display:flex;align-items:center;gap:10px;min-width:0;}
.card-title{font-weight:700;font-size:14.5px;}
.card-sub{color:var(--muted);font-size:12.5px;margin-top:3px;}
.card-body{padding:14px 16px 16px;border-top:1px solid var(--border);}
.card-actions{display:flex;gap:6px;flex-shrink:0;}

form.inline-form{background:var(--bg);border:1px solid var(--border);border-radius:var(--radius);padding:14px 16px;margin-bottom:16px;}
.form-title{font-weight:700;font-size:14px;margin-bottom:10px;}
.form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;}
.field label{display:block;font-size:11.5px;color:var(--muted);margin-bottom:5px;}
.input,.select,textarea{width:100%;background:var(--panel);border:1px solid var(--border);border-radius:7px;padding:9px 10px;color:var(--text);font-size:13.5px;}
textarea{resize:vertical;min-height:56px;}
.form-actions{display:flex;gap:8px;justify-content:flex-start;margin-top:12px;}
.radio-row{display:flex;gap:16px;align-items:center;font-size:13px;margin:6px 0 2px;flex-wrap:wrap;}
.radio-row label{display:flex;align-items:center;gap:6px;color:var(--text);cursor:pointer;}

.hint{color:var(--muted);font-size:12px;margin-top:8px;}
.empty-state{text-align:center;padding:36px 18px;color:var(--muted);font-size:13.5px;}
.empty-state .btn{margin-top:14px;}

.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:var(--panel-2);border:1px solid var(--border);padding:10px 18px;border-radius:20px;font-size:12.5px;z-index:100;box-shadow:0 6px 20px rgba(0,0,0,.4);max-width:90%;text-align:center;}
.toast.err{border-color:var(--danger);color:var(--danger);}

/* diagram */
.hint-bar{background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:9px 14px;font-size:13px;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;}
.svg-wrap{border:1px solid var(--border);border-radius:var(--radius);overflow:auto;background:var(--bg);margin-bottom:14px;}
.legend-row{display:flex;gap:14px;flex-wrap:wrap;font-size:11.5px;color:var(--muted);margin-bottom:14px;}
.legend-item{display:flex;align-items:center;gap:5px;}
.legend-swatch{width:10px;height:10px;border-radius:50%;display:inline-block;}

.core-swatch{display:inline-block;width:13px;height:13px;border-radius:3px;flex-shrink:0;box-shadow:0 0 0 1px rgba(255,255,255,.18) inset;}
.swatch-pair{display:inline-flex;align-items:center;gap:2px;}

.chain-row{background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:10px 12px;margin-bottom:8px;font-size:12.5px;}
.chain-range{font-weight:700;margin-left:6px;}
.chain-arrow{color:var(--muted);margin:0 5px;}
.chain-hop{color:var(--text);}
.chain-final{font-weight:700;}
.chain-final.term{color:var(--ok);}
.chain-final.unassigned{color:var(--amber);}
.chain-final.cycle{color:var(--danger);}

.table{width:100%;border-collapse:collapse;font-size:12.5px;margin-top:10px;}
.table th{text-align:right;color:var(--muted);font-weight:600;padding:8px 6px;border-bottom:1px solid var(--border);font-size:11.5px;}
.table td{padding:8px 6px;border-bottom:1px solid var(--border);vertical-align:middle;}

.node-chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px;}
.node-chip{display:inline-flex;align-items:center;gap:6px;background:var(--panel);border:1px solid var(--border);padding:5px 10px;border-radius:20px;font-size:12px;cursor:pointer;}
.node-chip:hover{border-color:var(--accent);}

@media (max-width:600px){
  .container{padding:12px;}
  .form-grid{grid-template-columns:1fr;}
  .search-input{max-width:none;}
}
</style>
</head>
<body>
<div id="app"></div>
<script>
/* ================= fiber color model (per Iran field standard supplied) ================= */
/* 6 core colors cycling inside each tube; 12 tube colors cycling every 72 cores */
const CORE_COLORS = [
  {name:'سفید', hex:'#F2F2ED'},
  {name:'قرمز', hex:'#E13B3B'},
  {name:'سبز', hex:'#2FA84F'},
  {name:'آبی', hex:'#29ABE2'},
  {name:'زرد', hex:'#F2D024'},
  {name:'مشکی', hex:'#202020'},
];
const TUBE_COLORS = [
  {name:'سفید', hex:'#F2F2ED'},
  {name:'قرمز', hex:'#E13B3B'},
  {name:'سبز', hex:'#2FA84F'},
  {name:'آبی', hex:'#29ABE2'},
  {name:'زرد', hex:'#F2D024'},
  {name:'مشکی', hex:'#202020'},
  {name:'قهوه‌ای', hex:'#8B5A2B'},
  {name:'بنفش', hex:'#B5179E'},
  {name:'نارنجی', hex:'#F2892E'},
  {name:'صورتی', hex:'#F2A6D0'},
  {name:'توسی', hex:'#9AA3B5'},
  {name:'بی‌رنگ', hex:'#3A445E', dashed:true},
];
function coreInfo(n){
  const coreIdx = (n-1)%6;
  const tubeIdx = Math.floor((n-1)/6)%12;
  const cycle = Math.floor((n-1)/72)+1;
  return { number:n, tube:tubeIdx+1, cycle, core:CORE_COLORS[coreIdx], tubeColor:TUBE_COLORS[tubeIdx] };
}
function swatchHTML(n){
  const info = coreInfo(n);
  const border = info.tubeColor.dashed ? `2px dashed ${info.tubeColor.hex}` : `2px solid ${info.tubeColor.hex}`;
  return `<span class="core-swatch" style="background:${info.core.hex};border:${border};" title="کور #${n} — تیوب ${info.tube} (${info.tubeColor.name}) / رنگ کور: ${info.core.name}"></span>`;
}
function coreLabelShort(n){
  const info = coreInfo(n);
  return `#${n} (تیوب${info.tube}-${info.tubeColor.name}/${info.core.name})`;
}

/* ================= ids & node types ================= */
function uid(){ return (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : 'id-'+Date.now()+'-'+Math.random().toString(16).slice(2); }
const NODE_TYPES = {
  olt:{label:'مرکز / OLT', color:'#EDEFF7'},
  closure:{label:'مفصل', color:'#3FD3C7'},
  odc:{label:'ODC', color:'#E8A33D'},
  fat:{label:'FAT', color:'#B5179E'},
  endpoint:{label:'مقصد نهایی (مشترک/دستگاه)', color:'#8FD98A'},
};

/* ================= state ================= */
let state = {
  loaded:false, noStorage:false,
  nodes:[], cables:[], assignments:[],
  view:'dashboard',
  cableSearch:'',
  activeCableId:null, activeNodeId:null,
  editingCableId:null, editingNodeId:null,
  showManualCableForm:false,
  diagMode:'view', // view | placingNode | connectPick1 | connectPick2 | movePick1 | movePick2
  connectFromId:null, moveNodeId:null,
  pendingNode:null, pendingCable:null,
  showAddAssign:false, assignAction:'continue',
  traceCableId:'', traceCore:'',
};

/* ================= storage ================= */
async function loadData(){
  if(!window.storage){ state.noStorage=true; state.loaded=true; render(); return; }
  try{ const r = await window.storage.get('fy-nodes', false); state.nodes = r&&r.value?JSON.parse(r.value):[]; }catch(e){ state.nodes=[]; }
  try{ const r = await window.storage.get('fy-cables', false); state.cables = r&&r.value?JSON.parse(r.value):[]; }catch(e){ state.cables=[]; }
  try{ const r = await window.storage.get('fy-assignments', false); state.assignments = r&&r.value?JSON.parse(r.value):[]; }catch(e){ state.assignments=[]; }
  state.loaded=true; render();
}
async function saveNodes(){ if(state.noStorage) return; try{ await window.storage.set('fy-nodes', JSON.stringify(state.nodes), false);}catch(e){ toast('ذخیره‌سازی گره‌ها ناموفق بود', true); } }
async function saveCables(){ if(state.noStorage) return; try{ await window.storage.set('fy-cables', JSON.stringify(state.cables), false);}catch(e){ toast('ذخیره‌سازی کابل‌ها ناموفق بود', true); } }
async function saveAssignments(){ if(state.noStorage) return; try{ await window.storage.set('fy-assignments', JSON.stringify(state.assignments), false);}catch(e){ toast('ذخیره‌سازی انشعاب‌ها ناموفق بود', true); } }

function toast(msg, isErr){
  const old=document.querySelector('.toast'); if(old) old.remove();
  const el=document.createElement('div'); el.className='toast'+(isErr?' err':''); el.textContent=msg;
  document.body.appendChild(el); setTimeout(()=>el.remove(),2800);
}

/* ================= lookups ================= */
function getNode(id){ return state.nodes.find(n=>n.id===id); }
function getCable(id){ return state.cables.find(c=>c.id===id); }
function nodeName(id){ const n=getNode(id); return n? n.name : 'گره حذف‌شده'; }
function cableName(id){ const c=getCable(id); return c? c.name : 'کابل حذف‌شده'; }
function outgoingCables(nodeId, excludeCableId){ return state.cables.filter(c=>c.fromNodeId===nodeId && c.id!==excludeCableId); }

function findAssignment(cableId, core){
  return state.assignments.find(a=>a.cableId===cableId && core>=a.coreStart && core<=a.coreEnd);
}
function assignmentsFor(cableId){ return state.assignments.filter(a=>a.cableId===cableId).sort((a,b)=>a.coreStart-b.coreStart); }

/* per-core recursive trace, returns signature string used for grouping */
function traceCoreSig(cableId, core, visited){
  visited = visited || new Set();
  const key = cableId+':'+core;
  if(visited.has(key)) return 'CYCLE';
  visited.add(key);
  const a = findAssignment(cableId, core);
  if(!a) return 'U';
  if(a.action==='terminate') return 'T:'+(a.label||nodeName(getCable(cableId).toNodeId));
  const nextCore = a.toCoreStart + (core - a.coreStart);
  return a.toCableId+'>'+traceCoreSig(a.toCableId, nextCore, visited);
}

/* range-based trace for display, walks a whole contiguous range at once */
function traceRangeChain(cableId, rs, re, visited){
  visited = visited || new Set();
  const key = cableId+':'+rs+'-'+re;
  const chain = [];
  let curCable=cableId, curRs=rs, curRe=re;
  while(true){
    const k = curCable+':'+curRs+'-'+curRe;
    if(visited.has(k)) return {chain, end:{type:'cycle'}};
    visited.add(k);
    const a = findAssignment(curCable, curRs);
    if(!a) return {chain, end:{type:'unassigned'}};
    if(a.action==='terminate'){
      return {chain, end:{type:'terminate', label:a.label || nodeName(getCable(curCable).toNodeId)}};
    }
    const ns = a.toCoreStart + (curRs - a.coreStart);
    const ne = a.toCoreStart + (curRe - a.coreStart);
    chain.push({cableId:a.toCableId, rs:ns, re:ne});
    curCable = a.toCableId; curRs=ns; curRe=ne;
  }
}

function cableBreakdownGroups(cable){
  const groups=[];
  let i=1;
  while(i<=cable.coreCount){
    const sig = traceCoreSig(cable.id, i, new Set());
    let j=i;
    while(j+1<=cable.coreCount && traceCoreSig(cable.id, j+1, new Set())===sig) j++;
    groups.push({rs:i, re:j, sig});
    i=j+1;
  }
  return groups;
}

/* ================= render ================= */
function render(){
  const app = document.getElementById('app');
  if(!state.loaded){ app.innerHTML = '<div class="loading">در حال بارگذاری اطلاعات…</div>'; return; }
  let html='';
  if(state.noStorage) html += '<div class="banner">ذخیره‌سازی در این محیط در دسترس نیست؛ تغییرات فقط تا پایان این جلسه باقی می‌مانند.</div>';
  html += topbarHTML() + tabsHTML() + '<div class="container">'+viewHTML()+'</div>';
  app.innerHTML = html;
}
function topbarHTML(){
  return `<div class="topbar"><div class="brand"><span class="brand-dot"></span>فیبریار <span class="brand-sub">— مدیریت شبکه فیبر نوری FTTH</span></div></div>`;
}
function tabsHTML(){
  const tabs=[['dashboard','داشبورد'],['diagram','نمای شبکه'],['cables','کابل‌ها'],['trace','ردیابی کور']];
  return '<div class="tabs">'+tabs.map(([id,l])=>`<div class="tab ${state.view===id?'active':''}" data-action="setView" data-view="${id}">${l}</div>`).join('')+'</div>';
}
function viewHTML(){
  if(state.view==='diagram') return renderDiagram();
  if(state.view==='cables') return renderCables();
  if(state.view==='trace') return renderTrace();
  return renderDashboard();
}

/* ---- dashboard ---- */
function renderDashboard(){
  const totalCores = state.cables.reduce((s,c)=>s+Number(c.coreCount||0),0);
  let assignedCores=0;
  state.cables.forEach(c=>assignmentsFor(c.id).forEach(a=>assignedCores += (a.coreEnd-a.coreStart+1)));
  const destCount = state.assignments.filter(a=>a.action==='terminate').length;
  const stats=[
    [state.nodes.length,'گره ثبت‌شده'],
    [state.cables.length,'کابل ثبت‌شده'],
    [totalCores,'مجموع کورها'],
    [assignedCores,'کور تعریف‌شده'],
    [destCount,'مقصد نهایی'],
  ];
  let html = '<div class="stats-row">'+stats.map(([n,l])=>`<div class="stat-card"><div class="stat-num">${n}</div><div class="stat-label">${l}</div></div>`).join('')+'</div>';
  if(state.nodes.length===0){
    html += `<div class="empty-state">برای شروع، وارد «نمای شبکه» شو و اولین گره (مثلاً مرکز مخابرات) را اضافه کن.<br><button class="btn btn-primary" data-action="setView" data-view="diagram">رفتن به نمای شبکه</button></div>`;
  } else if(state.cables.length===0){
    html += `<div class="empty-state">حالا بین گره‌ها کابل بکش تا شبکه شکل بگیرد.<br><button class="btn btn-primary" data-action="setView" data-view="diagram">رفتن به نمای شبکه</button></div>`;
  } else {
    html += `<div class="section-head"><div class="section-title">کابل‌های اخیر</div></div>`;
    state.cables.slice(-5).reverse().forEach(c=>{
      html += `<div class="card"><div class="card-head" data-action="openCableFromList" data-id="${c.id}">
        <div class="card-head-main"><div><div class="card-title">${esc(c.name)}</div><div class="card-sub">${esc(nodeName(c.fromNodeId))} ← ${esc(nodeName(c.toNodeId))} · ${c.coreCount} کور</div></div></div>
      </div></div>`;
    });
  }
  return html;
}

/* ---- diagram ---- */
function modeHint(){
  switch(state.diagMode){
    case 'placingNode': return 'روی نقشه کلیک کن تا گرهٔ جدید در آن نقطه قرار بگیرد.';
    case 'connectPick1': return 'گرهٔ نزدیک‌تر به مرکز (ابتدای کابل) را انتخاب کن.';
    case 'connectPick2': return 'گرهٔ دوم (انتهای کابل) را انتخاب کن.';
    case 'movePick1': return 'گره‌ای که می‌خواهی جابه‌جا کنی را انتخاب کن.';
    case 'movePick2': return 'مکان جدید را روی نقشه انتخاب کن.';
    default: return 'روی یک گره یا کابل کلیک کن تا جزئیاتش را ببینی.';
  }
}
function renderDiagram(){
  let html = `<div class="section-head"><div class="section-title">نمای شبکه</div>
    <div class="btn-row">
      <button class="btn ${state.diagMode==='placingNode'?'active-mode':''}" data-action="modeAddNode">+ گره</button>
      <button class="btn ${state.diagMode.startsWith('connect')?'active-mode':''}" data-action="modeAddCable">+ کابل</button>
      <button class="btn ${state.diagMode.startsWith('move')?'active-mode':''}" data-action="modeMoveNode">جابه‌جایی گره</button>
      ${state.diagMode!=='view' ? '<button class="btn btn-danger" data-action="modeCancel">لغو</button>' : ''}
    </div></div>`;

  html += `<div class="hint-bar"><span>${modeHint()}</span></div>`;

  if(state.pendingNode) html += nodeFormHTML(null, state.pendingNode);
  if(state.editingNodeId) html += nodeFormHTML(getNode(state.editingNodeId));
  if(state.pendingCable) html += cableFormHTML(null, state.pendingCable);
  if(state.editingCableId && !state.pendingCable) html += cableFormHTML(getCable(state.editingCableId));

  html += `<div class="legend-row">${Object.entries(NODE_TYPES).map(([k,v])=>`<span class="legend-item"><span class="legend-swatch" style="background:${v.color}"></span>${v.label}</span>`).join('')}</div>`;

  html += `<div class="svg-wrap">${diagramSVG()}</div>`;

  if(state.nodes.length && !state.pendingNode && !state.editingNodeId){
    html += `<div class="node-chips">${state.nodes.map(n=>`<span class="node-chip" data-action="nodeClick" data-id="${n.id}"><span class="legend-swatch" style="background:${NODE_TYPES[n.type].color}"></span>${esc(n.name)}</span>`).join('')}</div>`;
  }

  if(state.activeNodeId && !state.editingNodeId){
    const n = getNode(state.activeNodeId);
    if(n) html += nodeDetailHTML(n);
  }
  if(state.activeCableId && !state.editingCableId && !state.pendingCable){
    const c = getCable(state.activeCableId);
    if(c) html += cableDetailHTML(c);
  }
  return html;
}

function diagramSVG(){
  const W=1500,H=560;
  let bg = `<rect x="0" y="0" width="${W}" height="${H}" fill="var(--bg)" data-action="canvasClick"></rect>`;
  let defs = `<defs><pattern id="grid" width="28" height="28" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="#212C46"/></pattern></defs>`;
  let gridRect = `<rect x="0" y="0" width="${W}" height="${H}" fill="url(#grid)" data-action="canvasClick"></rect>`;

  let edges = state.cables.map(c=>{
    const a = getNode(c.fromNodeId), b = getNode(c.toNodeId);
    if(!a||!b) return '';
    const sel = state.activeCableId===c.id;
    const mx=(a.x+b.x)/2, my=(a.y+b.y)/2;
    return `<g>
      <line x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}" stroke="${sel?'var(--amber)':'var(--accent)'}" stroke-width="${sel?3:2}"></line>
      <line x1="${a.x}" y1="${a.y}" x2="${b.x}" y2="${b.y}" stroke="transparent" stroke-width="18" data-action="cableClick" data-id="${c.id}" style="cursor:pointer"></line>
      <rect x="${mx-38}" y="${my-16}" width="76" height="15" fill="var(--bg)" opacity="0.75" pointer-events="none"></rect>
      <text x="${mx}" y="${my-5}" text-anchor="middle" fill="${sel?'var(--amber)':'var(--muted)'}" font-size="10" font-family="Vazirmatn" pointer-events="none">${esc(c.name)} · ${c.coreCount}ک</text>
    </g>`;
  }).join('');

  let nodes = state.nodes.map(n=>{
    const sel = state.activeNodeId===n.id;
    const color = sel ? 'var(--amber)' : NODE_TYPES[n.type].color;
    let shape='';
    if(n.type==='olt') shape=`<rect x="${n.x-13}" y="${n.y-13}" width="26" height="26" rx="4" fill="#0B1220" stroke="${color}" stroke-width="2.5"></rect>`;
    else if(n.type==='odc') shape=`<rect x="${n.x-9}" y="${n.y-9}" width="18" height="18" fill="var(--panel)" stroke="${color}" stroke-width="2.5"></rect>`;
    else if(n.type==='fat') shape=`<rect x="${n.x-9}" y="${n.y-9}" width="18" height="18" rx="8" fill="var(--panel)" stroke="${color}" stroke-width="2.5"></rect>`;
    else if(n.type==='endpoint') shape=`<circle cx="${n.x}" cy="${n.y}" r="9" fill="${color}" stroke="#0B1220" stroke-width="1.5"></circle>`;
    else shape=`<circle cx="${n.x}" cy="${n.y}" r="7" fill="var(--panel)" stroke="${color}" stroke-width="2.5"></circle>`;
    return `<g>
      ${shape}
      <circle cx="${n.x}" cy="${n.y}" r="17" fill="transparent" data-action="nodeClick" data-id="${n.id}" style="cursor:pointer"></circle>
      <rect x="${n.x-45}" y="${n.y-32}" width="90" height="14" fill="var(--bg)" opacity="0.75" pointer-events="none"></rect>
      <text x="${n.x}" y="${n.y-21}" text-anchor="middle" fill="var(--text)" font-size="11" font-weight="600" font-family="Vazirmatn" pointer-events="none">${esc(n.name)}</text>
    </g>`;
  }).join('');

  return `<svg width="${W}" height="${H}" style="display:block;">${defs}${bg}${gridRect}${edges}${nodes}</svg>`;
}

